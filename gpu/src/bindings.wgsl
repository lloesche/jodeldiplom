// The prelude of the separator's, the beat network's, the speech model's
// and the recogniser's kernels: each reads `src` and `aux` and writes
// `dst`; `p` holds its numbers (named per kernel). Buffers hold f32,
// tokens of features laid out one after the other.

struct Params {
    f0: u32, f1: u32, f2: u32, f3: u32,
    f4: u32, f5: u32, f6: u32, f7: u32,
    f8: u32, f9: u32, f10: u32, f11: u32,
}

@group(0) @binding(0) var<storage, read> src: array<f32>;
@group(0) @binding(1) var<storage, read> aux: array<f32>;
@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
@group(0) @binding(3) var<uniform> p: Params;
