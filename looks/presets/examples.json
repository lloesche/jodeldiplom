      "layers": [
        {"pass": "saturation", "knobs": {"saturation": 1.6}},
        {"pass": "halftone_cmyk", "knobs": {"dot": 9, "registration": 0.35}},
        {"pass": "curve", "knobs": {"contrast": 0.2}}
      ]
    },
    {
      "id": "noir",
      "name": "Noir",
