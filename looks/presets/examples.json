{
  "family": "examples",
  "about": "The hand-made examples: a look each for a kind of song, to start from.",
  "looks": [
    {
      "id": "35mm-night-drive",
      "name": "35mm night drive",
      "about": "night film: teal shadows, warm lights glowing red round the edges, coarse grain breathing with the bass",
      "tags": ["synth-pop", "rock", "night and city", "freedom and road trips", "70s film stock"],
      "layers": [
        {"pass": "split_tone", "knobs": {"shadows": 0.53, "lights": 0.07, "amount": 0.6}},
        {"pass": "curve", "knobs": {"contrast": 0.35, "fade": 0.2}},
        {"pass": "halation", "knobs": {"amount": 0.6, "radius": 16}},
        {"pass": "grain", "knobs": {"amount": 0.45, "size": 1.4}},
        {"pass": "vignette", "knobs": {"amount": 0.45}}
      ]
    },
    {
      "id": "psychedelic-60s",
      "name": "Psychedelic 60s",
      "about": "the colours turning round the wheel each section, the picture flowing, folded into a kaleidoscope in the breaks",
      "tags": ["rock", "60s psychedelic", "drugs and psychedelia", "dreams and the surreal"],
      "layers": [
        {"pass": "saturation", "knobs": {"saturation": 1.5, "vibrance": 0.4}},
        {"pass": "liquid", "knobs": {"amount": 0.5}},
        {"pass": "hue", "knobs": {"spread": 0.35, "speed": 0.2}},
        {"pass": "kaleidoscope", "knobs": {"segments": 6}, "mix": 0.0, "drive": [{"knob": "mix", "by": "instrumental", "amount": 0.8}, {"knob": "turn", "by": "bar_phase", "amount": 0.25}]}
      ]
    },
    {
      "id": "oil-painting",
      "name": "Oil painting",
      "about": "flat painterly patches, strokes catching the light, canvas showing through",
      "tags": ["classical and orchestral", "folk", "ballads", "love"],
      "layers": [
        {"pass": "kuwahara", "knobs": {"radius": 5}},
        {"pass": "oil_paint", "knobs": {"brush": 6, "relief": 0.6}},
        {"pass": "canvas", "knobs": {"amount": 0.5}}
      ]
    },
    {
      "id": "comic-ink",
      "name": "Comic ink",
      "about": "cel shading in four tones with bold ink lines, a halftone in the shadows",
      "tags": ["punk", "pop", "humour", "children's songs", "80s"],
      "layers": [
        {"pass": "posterize_ink", "knobs": {"steps": 4, "ink": 0.85, "width": 1.8, "vivid": 1.4}},
        {"pass": "halftone", "knobs": {"dot": 7, "ink": 1.0, "amount": 0.35}}
      ]
    },
    {
      "id": "pop-art-halftone",
      "name": "Pop-art halftone",
      "about": "four-colour process dots a little off register, bold flat colour",
